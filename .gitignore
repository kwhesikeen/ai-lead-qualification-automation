# CedarLead repository ignore rules

# Environment and secrets
.env
.env.*
!.env.example

# Editor / IDE files
.vscode/
.idea/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp

# Local Docker / backup files
docker-compose.yml.backup
*.backup
*.bak

# CedarLead local runtime files
local-files/*
!local-files/.gitkeep

# Local n8n exports or scratch files
*.sqlite
*.sqlite3
*.db

# Postman local/private exports
postman/*-private.postman_environment.json
postman/*-local-secret.postman_environment.json
