      "name": "Load Leads for SLA Check",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "ne9gKIlcdiEYrgHB",
          "name": "Google Sheets account"
