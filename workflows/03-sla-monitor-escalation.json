    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst now = new Date();\n\nconst ACTIVE_STATUSES = [\n  'NEW',\n  'CONTACTED',\n  'QUALIFIED',\n  'PROPOSAL'\n];\n\n// Minimum time before we alert again\nconst ESCALATION_COOLDOWN_HOURS = {\n  P1: 1,\n  P2: 6,\n  P3: 24\n};\n\nconst results = [];\n\nfor (const item of rows) {\n\n  const lead = { ...item.json };\n\n  const status =\n    String(lead.lifecycleStatus || '')\n      .trim()\n      .toUpperCase();\n\n  if (!ACTIVE_STATUSES.includes(status)) {\n    continue;\n  }\n\n  if (!lead.leadId) {\n    continue;\n  }\n\n  // -----------------------------------\n  // Decide which deadline applies\n  // -----------------------------------\n\n  let dueAtRaw = '';\n\n  if (status === 'NEW') {\n    dueAtRaw = lead.slaDueAt || '';\n  } else {\n    dueAtRaw = lead.nextFollowUpAt || '';\n  }\n\n  if (!dueAtRaw) {\n    continue;\n  }\n\n  const dueAt = new Date(dueAtRaw);\n\n  if (Number.isNaN(dueAt.getTime())) {\n    continue;\n  }\n\n  // Not overdue yet\n  if (now <= dueAt) {\n    continue;\n  }\n\n  // -----------------------------------\n  // Prevent alert spam\n  // -----------------------------------\n\n  const priority =\n    String(lead.priority || 'P3')\n      .trim()\n      .toUpperCase();\n\n  const cooldownHours =\n    ESCALATION_COOLDOWN_HOURS[priority] ?? 24;\n\n  const lastEscalatedRaw =\n    lead.lastEscalatedAt || '';\n\n  if (lastEscalatedRaw) {\n\n    const lastEscalated =\n      new Date(lastEscalatedRaw);\n\n    if (!Number.isNaN(lastEscalated.getTime())) {\n\n      const nextAllowedEscalation =\n        new Date(\n          lastEscalated.getTime() +\n          cooldownHours * 60 * 60 * 1000\n        );\n\n      if (now < nextAllowedEscalation) {\n        continue;\n      }\n    }\n  }\n\n  // -----------------------------------\n  // Escalation metadata\n  // -----------------------------------\n\n  const currentCount =\n    Number(lead.escalationCount || 0);\n\n  const newCount =\n    currentCount + 1;\n\n  const overdueMinutes =\n    Math.floor(\n      (now.getTime() - dueAt.getTime()) /\n      60000\n    );\n\n  let escalationLevel = 'LEVEL_1';\n\n  if (newCount >= 2) {\n    escalationLevel = 'LEVEL_2';\n  }\n\n  if (newCount >= 3) {\n    escalationLevel = 'LEVEL_3';\n  }\n\n  results.push({\n    json: {\n      ...lead,\n\n      effectiveDueAt:\n        dueAt.toISOString(),\n\n      overdueMinutes,\n\n      escalationLevel,\n\n      escalationCount:\n        newCount,\n\n      lastEscalatedAt:\n        now.toISOString(),\n\n      escalationPreparedAt:\n        now.toISOString(),\n\n      escalationRequired:\n        true\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "f48e1e67-6b4c-47b9-bd0d-c300b288d21d",
      "name": "Evaluate SLA Breaches"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.assignedOwnerEmail || 'sla-alerts@example.com' }}",
        "subject": "={{ `[${$json.escalationLevel}] OVERDUE ${$json.priority} Lead: ${$json.name} — ${$json.company}` }}",
        "emailType": "text",
        "message": "={{ `CedarLead SLA Escalation  An active sales lead has exceeded its required follow-up deadline.  Lead ID: ${$json.leadId} Name: ${$json.name} Company: ${$json.company} Email: ${$json.email}  Lifecycle Status: ${$json.lifecycleStatus} Priority: ${$json.priority} Lead Score: ${$json.leadScore} Temperature: ${$json.leadTemperature}  Assigned Owner: ${$json.assignedOwner || 'Unassigned'} Owner Email: ${$json.assignedOwnerEmail || 'Not assigned'}  Required Deadline: ${$json.effectiveDueAt}  Minutes Overdue: ${$json.overdueMinutes}  Escalation Level: ${$json.escalationLevel}  Escalation Count: ${$json.escalationCount}  Recommended action: Review and contact this lead immediately.  CedarLead Automation` }}",
        "options": {
          "senderName": "CedarLead SLA Monitor"
        }
      },
