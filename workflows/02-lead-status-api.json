    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json.body ?? $json;\n\nconst leadId = String(\n  input.leadId ?? ''\n).trim().toUpperCase();\n\nconst requestedStatus = String(\n  input.status ?? ''\n).trim().toUpperCase();\n\nconst allowedStatuses = [\n  'NEW',\n  'CONTACTED',\n  'QUALIFIED',\n  'PROPOSAL',\n  'WON',\n  'LOST'\n];\n\nconst errors = [];\n\n// -------------------------\n// Validate Lead ID\n// -------------------------\n\nif (!leadId) {\n  errors.push('leadId is required');\n}\n\n// -------------------------\n// Validate status\n// -------------------------\n\nif (!requestedStatus) {\n  errors.push('status is required');\n} else if (\n  !allowedStatuses.includes(requestedStatus)\n) {\n  errors.push(\n    `status must be one of: ${allowedStatuses.join(', ')}`\n  );\n}\n\n// -------------------------\n// Optional ownership updates\n// -------------------------\n\nconst assignedOwner = String(\n  input.assignedOwner ?? ''\n).trim();\n\nconst assignedOwnerEmail = String(\n  input.assignedOwnerEmail ?? ''\n).trim();\n\n// Basic optional email validation\nif (\n  assignedOwnerEmail &&\n  !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(\n    assignedOwnerEmail\n  )\n) {\n  errors.push(\n    'assignedOwnerEmail must be a valid email address'\n  );\n}\n\nreturn {\n  json: {\n    leadId,\n    requestedStatus,\n\n    assignedOwner,\n    assignedOwnerEmail,\n\n    isValidStatusUpdate:\n      errors.length === 0,\n\n    validationErrors:\n      errors,\n\n    statusRequestReceivedAt:\n      new Date().toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
