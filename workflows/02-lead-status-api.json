        "responseBody": "={{\n{\n  success: false,\n  status: \"conflict\",\n  message: \"The requested lifecycle transition is not allowed.\",\n\n  leadId: $json.leadId,\n\n  currentStatus:\n    $json.currentStatus,\n\n  requestedStatus:\n    $json.requestedStatus,\n\n  allowedNextStatuses:\n    $json.allowedNextStatuses\n}\n}}",
