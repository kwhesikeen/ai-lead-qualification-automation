    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = { ...$json };\n\nconst request =\n  $('Validate Status Update')\n    .first()\n    .json;\n\nconst currentStatus = String(\n  lead.lifecycleStatus || 'NEW'\n)\n  .trim()\n  .toUpperCase();\n\nconst requestedStatus =\n  request.requestedStatus;\n\n\n// ----------------------------------\n// Legal lifecycle transitions\n// ----------------------------------\n\nconst transitions = {\n\n  NEW: [\n    'CONTACTED',\n    'LOST'\n  ],\n\n  CONTACTED: [\n    'QUALIFIED',\n    'LOST'\n  ],\n\n  QUALIFIED: [\n    'PROPOSAL',\n    'LOST'\n  ],\n\n  PROPOSAL: [\n    'WON',\n    'LOST'\n  ],\n\n  WON: [],\n\n  LOST: []\n\n};\n\n\nconst allowedNextStatuses =\n  transitions[currentStatus] ?? [];\n\n\n// ----------------------------------\n// Idempotency\n// ----------------------------------\n\nconst noChange =\n  requestedStatus === currentStatus;\n\nconst transitionAllowed =\n  noChange ||\n  allowedNextStatuses.includes(\n    requestedStatus\n  );\n\n\nreturn {\n  json: {\n\n    ...lead,\n\n    requestedStatus,\n\n    currentStatus,\n\n    transitionAllowed,\n\n    noChange,\n\n    allowedNextStatuses,\n\n    requestedAssignedOwner:\n      request.assignedOwner,\n\n    requestedAssignedOwnerEmail:\n      request.assignedOwnerEmail,\n\n    statusRequestReceivedAt:\n      request.statusRequestReceivedAt\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        -320
      ],
      "id": "0bb34988-c87c-468f-9e7e-a1d6164cd624",
      "name": "Validate Lifecycle Transition"
    },
