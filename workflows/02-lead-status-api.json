    {
      "parameters": {
        "jsCode": "const lead = { ...$json };\n\nconst now =\n  new Date();\n\nconst nowIso =\n  now.toISOString();\n\nconst newStatus =\n  lead.requestedStatus;\n\n\n// -----------------------------------\n// Ownership\n// -----------------------------------\n\nconst assignedOwner =\n  lead.requestedAssignedOwner ||\n  lead.assignedOwner ||\n  'CedarLead Sales Queue';\n\nconst assignedOwnerEmail =\n  lead.requestedAssignedOwnerEmail ||\n  lead.assignedOwnerEmail ||\n  '';\n\n\n// -----------------------------------\n// Contact timestamp\n// -----------------------------------\n\nlet lastContactedAt =\n  lead.lastContactedAt || '';\n\nif (\n  newStatus === 'CONTACTED' &&\n  !lead.noChange\n) {\n  lastContactedAt = nowIso;\n}\n\n\n// -----------------------------------\n// Next follow-up\n// -----------------------------------\n\nlet nextFollowUpAt =\n  lead.nextFollowUpAt || '';\n\nif (!lead.noChange) {\n\n  let followUpHours = null;\n\n  if (newStatus === 'CONTACTED') {\n    followUpHours = 24;\n  }\n\n  if (newStatus === 'QUALIFIED') {\n    followUpHours = 24;\n  }\n\n  if (newStatus === 'PROPOSAL') {\n    followUpHours = 48;\n  }\n\n  if (followUpHours !== null) {\n\n    nextFollowUpAt =\n      new Date(\n        now.getTime() +\n        followUpHours *\n        60 *\n        60 *\n        1000\n      ).toISOString();\n\n  }\n\n  if (\n    newStatus === 'WON' ||\n    newStatus === 'LOST'\n  ) {\n    nextFollowUpAt = '';\n  }\n}\n\n\n// -----------------------------------\n// Final lifecycle record\n// -----------------------------------\n\nreturn {\n  json: {\n\n    ...lead,\n\n    previousStatus:\n      lead.currentStatus,\n\n    lifecycleStatus:\n      newStatus,\n\n    assignedOwner,\n\n    assignedOwnerEmail,\n\n    lastContactedAt,\n\n    nextFollowUpAt,\n\n    statusUpdatedAt:\n      lead.noChange\n        ? lead.statusUpdatedAt\n        : nowIso,\n\n    lifecycleVersion:\n      '1.1'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
